    "lmbda": 0.95,
    "epsilon": 0.2,
    "sigma_init": 0.6,
    "sigma_min": 0.15,
    "sigma_decay": 0.9998,
    "lr_actor_discrete": 0.003,
    "lr_actor_continuous": 0.002,
    "lr_critic": 0.007
}
