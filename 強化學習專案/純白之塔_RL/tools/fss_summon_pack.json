{
    "fixed_groups": [
        "bias",
        "monster_dist",
        "monster_angle_sincos",
        "blood_pack_dist",
        "blood_pack_angle_sincos"
        
    ],
    "candidate_groups": [
        "monster_relative_angle",
        "monster_health",
        "monster_facing_sincos",
        "blood_pack_relative_angle",
        "enemy_proj_count",
        "nearest_enemy_proj",
        "wall_dist",
        "wall_dist_back",
        "casting_info",
        "player_health",
        "total_monster_hp",
        "alive_monster_count",
        "ready_skill_count",
        "hp_advantage",
        "blood_pack_count"
    ],
    "curriculum": "curricula/summon_pack_training.json",
    "eval_epochs": 1000,
    "steps_per_epoch": 200,
    "eval_window": 100,
    "tolerance_count": 1,
    "output": "fss_results_summon_pack.json",

